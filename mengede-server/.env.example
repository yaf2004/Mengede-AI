PORT=4000

# MongoDB connection string. Falls back to the root .env.example value if you
# run everything from the repo root; set it here too if you run this folder
# standalone.
MONGODB_URI=mongodb://localhost:27017/mengede_dev

# links.et (https://links.et) — real payment-receipt verification.
# Key starts with vk_live_, minted at https://links.et/dashboard/keys.
# Never commit the real key — this is server-side only, never sent to the browser.
LINKS_ET_API_KEY=
LINKS_ET_BASE_URL=https://links.et
