PORT=4000

# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/mengede_dev
MONGODB_DB=mengede_dev

# Gemini — server-side only. Never expose the real key to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional YouTube Data API key for direct YouTube search.
YOUTUBE_API_KEY=

# links.et — real payment-receipt verification.
LINKS_ET_API_KEY=
LINKS_ET_BASE_URL=https://links.et

# Optional API rate limits per minute.
ASSISTANT_RATE_LIMIT=30
DISCOVERY_RATE_LIMIT=20
VERIFY_RATE_LIMIT=10
