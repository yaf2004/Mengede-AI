# Root environment variables
# MongoDB connection string (local Docker Compose, Atlas, or any hosted Mongo)
MONGODB_URI=mongodb://localhost:27017/mengede_dev
# Optional: override the database name if it's not encoded in MONGODB_URI
MONGODB_DB=

# Gemini (Interactions API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEARCH=1

# links.et (https://links.et) — Ethiopian payment-receipt verification.
# Key starts with vk_live_, minted at https://links.et/dashboard/keys.
# Server-side only — never send it from the browser.
LINKS_ET_API_KEY=

# Voxide frontend publishable key (overrides mengede-web/.env.example)
VITE_VOXIDE_PUBLIC_KEY=

# Local Mongo via Docker Compose:
#   docker-compose up -d db
# then set MONGODB_URI to:
#   mongodb://localhost:27017/mengede_dev
