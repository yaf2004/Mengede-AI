# Root environment variables
# Provide your Postgres connection string (Neon/Postgres)
DATABASE_URL=
# Unpooled connection string for migrations (Neon recommends a direct URL)
DATABASE_URL_DIRECT=

# Gemini (Interactions API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEARCH=1

# Voxide frontend publishable key (overrides mengede-web/.env.example)
VITE_VOXIDE_PUBLIC_KEY=

# Local Postgres docker example (commented):
# For local development you can run Postgres via Docker Compose and set DATABASE_URL to:
# postgres://postgres:postgres@localhost:5432/mengede_dev
